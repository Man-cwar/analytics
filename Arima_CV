from sklearn.model_selection import TimeSeriesSplit
from sklearn.metrics import mean_squared_error
from sklearn.metrics import mean_absolute_percentage_error
from statsmodels.tsa.statespace.sarimax import SARIMAX
import statsmodels.api as sm
tscv = TimeSeriesSplit(n_splits = 4)
rmse = []
mape=[]
mape_train=[]
#mape_test=[]
for train_index, test_index in tscv.split(cross_validation):
    cv_train, cv_test = cross_validation.iloc[train_index], cross_validation.iloc[test_index]
    arma = sm.tsa.arima.ARIMA(cv_train,order=(4,2,1)).fit()
    predict_train = arma.predict(cv_train.index.values[0],cv_train.index.values[-1])
    predictions = arma.predict(cv_test.index.values[0], cv_test.index.values[-1])
    true_values = cv_test.values
    true_train = cv_train.values
    rmse.append(sqrt(mean_squared_error(true_values, predictions)))
    mape.append(mean_absolute_percentage_error(true_values, predictions))
    mape_train.append(mean_absolute_percentage_error(true_train, predict_train))
