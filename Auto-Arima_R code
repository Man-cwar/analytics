                      sheet = "Input_R")

#China_Seg <- read_excel(file.choose(), sheet = "Input_R")

############################################### PREMIUM ########################################################

###################################### BCPR ####################################################

Input1<-China_Seg[,c("BCPR","SEAS_BCPR","BCPR_TPI","BCPR_LC","BCPR_PA",
                     "NEWYEAR","TREND6","COVID","CHIPCAR","GDP","CPI")]
#trend1->6->1->6
train1=Input1[1:136,]
test1=Input1[137:156,]

###Converting to timeseries###
tsBCPR<-ts(train1$BCPR,start = c(2013,1),end = c(2024,4),frequency = 12)
tsBCPR <- tsclean(tsBCPR)

### MODEL TESTS ###gdp, cpi added, cpi remo
m1=auto.arima(tsBCPR,seasonal = F,stepwise = T,approximation = T,
              xreg = as.matrix(train1[c(2,6,7,8,9,10)]))
bcprcoef = coeftest(m1)
bcprcoef

### Forecast ##
f1<-forecast(m1,xreg =as.matrix(test1[c(2,6,7,8,9,10)]))
plot(f1)
points(index(tsBCPR),f1$fitted,col="red","l")
exp(f1$fitted)
BCPRFORECAST <- exp(f1$mean)
BCPRFORECAST

