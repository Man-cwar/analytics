def plot_ccf_custom(series1, series2, title_suffix, max_lags_val):
    series1_clean = series1.dropna()
    series2_clean = series2.dropna()
    common_index = series1_clean.index.intersection(series2_clean.index)
    series1_aligned = series1_clean.loc[common_index]
    series2_aligned = series2_clean.loc[common_index]

    if len(series1_aligned) < max_lags_val * 2: # Need enough data for meaningful lags
        print(f"Warning: Not enough common data points for CCF between {series1.name} and {series2.name}. Skipping.")
        return

    # Using matplotlib.pyplot.xcorr for symmetric CCF
    plt.figure(figsize=(10, 5))
    plt.xcorr(series1_aligned, series2_aligned, usevlines=True, maxlags=max_lags_val, normed=True, lw=2)
    plt.title(f'Cross-Correlation between {TARGET_VAR} and {title_suffix}\n(Positive Lag: {title_suffix} leads {TARGET_VAR})')
    plt.axhline(0, color='gray', linestyle='--')
    plt.xlabel('Lag (Months)')
    plt.ylabel('Correlation')
    plt.grid(True)
    plt.show()

