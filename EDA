def plot_monthly_seasonal_pattern(df_input, column_name, title_prefix=""):
    df_temp = df_input.copy()
    df_temp['month'] = df_temp.index.month
    df_temp['year'] = df_temp.index.year

    plt.figure(figsize=(12, 6))
    sns.lineplot(data=df_temp, x='month', y=column_name, hue='year', palette='viridis', marker='o')
    plt.title(f'{title_prefix} Monthly Seasonal Plot of {column_name}')
    plt.xlabel('Month')
    plt.ylabel(column_name)
    plt.legend(title='Year', bbox_to_anchor=(1.05, 1), loc='upper left')
    plt.xticks(range(1, 13), ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'])
    plt.grid(True)
    plt.tight_layout()
    plt.show()

