# --- Granger Causality Test ---
print(f"\n--- Granger Causality Tests (Exogenous -> {TARGET_VAR} on Training Data) ---")
max_lags_granger = 12 # Test up to 12 months lag
for exo_col in EXOG_VARS:
    print(f"\n--- Testing Granger Causality for {exo_col} on {TARGET_VAR} ---")
    data_for_granger = df_train[[TARGET_VAR, exo_col]].dropna()
    if len(data_for_granger) < max_lags_granger + 2:
        print(f"  Not enough data points ({len(data_for_granger)}) for Granger Causality test with max_lags={max_lags_granger}. Skipping.")
        continue
    try:
        granger_results = grangercausalitytests(data_for_granger, max_lags_granger, verbose=False)
        p_value = granger_results[max_lags_granger][0]['ssr_ftest'][1]
        print(f"  P-value for Granger Causality from {exo_col} to {TARGET_VAR} (max lag {max_lags_granger}): {p_value:.3f}")
        if p_value < 0.05:
            print(f"  Conclusion: {exo_col} Granger-causes {TARGET_VAR} (at 5% significance level).")
        else:
            print(f"  Conclusion: {exo_col} does NOT Granger-cause {TARGET_VAR} (at 5% significance level).")
    except Exception as e:
        print(f"  Could not perform Granger Causality test for {exo_col}: {e}")

