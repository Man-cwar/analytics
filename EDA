def run_stationarity_tests(series, name):
    print(f"\n--- Stationarity Test for: {name} ---")
    if len(series.dropna()) < 2:
        print("Not enough data points for stationarity test.")
        return

    # ADF Test
    adf_result = adfuller(series.dropna())
    print(f'ADF Statistic: {adf_result[0]:.2f}')
    print(f'p-value: {adf_result[1]:.3f}')
    print('Critical Values:')
    for key, value in adf_result[4].items():
        print(f'   {key}: {value:.2f}')
    if adf_result[1] <= 0.05:
        print("Conclusion: Series is likely stationary (Reject H0 of unit root)")
    else:
        print("Conclusion: Series is likely non-stationary (Fail to Reject H0 of unit root)")

    # KPSS Test
    # KPSS test requires at least 8 observations
    if len(series.dropna()) >= 8:
        kpss_result = kpss(series.dropna(), regression='c', nlags='auto') # 'c' for constant, 'ct' for trend
        print(f'KPSS Statistic: {kpss_result[0]:.2f}')
        print(f'p-value: {kpss_result[1]:.3f}')
        print('Critical Values:')
        for key, value in kpss_result[3].items():
            print(f'   {key}: {value:.2f}')
        if kpss_result[1] <= 0.05:
            print("Conclusion: Series is likely non-stationary (Reject H0 of stationarity)")
        else:
            print("Conclusion: Series is likely stationary (Fail to Reject H0 of stationarity)")
    else:
        print("Not enough data for KPSS test.")


for col in df_train.columns:
    run_stationarity_tests(df_train[col], col)

