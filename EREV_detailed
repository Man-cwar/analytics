def visualize_outlier_transformations(df_original: pd.DataFrame, df_cleaned: pd.DataFrame, columns: list):
    """Visualize outlier transformations for specified columns."""
    import matplotlib.pyplot as plt
    
    columns_with_changes = [col for col in columns if col in df_original.columns and col in df_cleaned.columns 
                           and not df_original[col].equals(df_cleaned[col])]
    
    if not columns_with_changes:
        print("No outliers were detected or capped in the specified columns.")
        return
    
    n_cols = len(columns_with_changes)
    fig, axes = plt.subplots(n_cols, 2, figsize=(18, 5*n_cols))
    
    if n_cols == 1:
        axes = axes.reshape(1, -1)
    
    for idx, col in enumerate(columns_with_changes):
        series_orig = df_original[col].dropna()
        series_clean = df_cleaned[col].dropna()
        changed_indices = series_orig.index[series_orig != series_clean]
        
        ax1 = axes[idx, 0]
        ax1.plot(series_orig.index, series_orig, 'o-', color='blue', alpha=0.6, label='Original', markersize=3)
        if len(changed_indices) > 0:
            ax1.scatter(changed_indices, series_orig.loc[changed_indices], 
                       color='red', s=100, marker='x', linewidths=3, label=f'Outliers ({len(changed_indices)})', zorder=5)
        ax1.set_title(f'{col} - Original Data')
        ax1.set_xlabel('Date')
        ax1.set_ylabel('Value')
        ax1.legend()
        ax1.grid(True, alpha=0.3)
        
        ax2 = axes[idx, 1]
        ax2.plot(series_clean.index, series_clean, 'o-', color='green', alpha=0.6, label='Cleaned', markersize=3)
        if len(changed_indices) > 0:
            ax2.scatter(changed_indices, series_clean.loc[changed_indices], 
                       color='orange', s=100, marker='o', label=f'Capped ({len(changed_indices)})', zorder=5)
            
            for change_idx in changed_indices[:5]:
                orig_val = series_orig.loc[change_idx]
                clean_val = series_clean.loc[change_idx]
                ax2.annotate(f'{orig_val:.2f}→{clean_val:.2f}', xy=(change_idx, clean_val), xytext=(10, 10), 
                           textcoords='offset points', fontsize=8, color='red',
                           bbox=dict(boxstyle='round,pad=0.3', facecolor='yellow', alpha=0.7),
                           arrowprops=dict(arrowstyle='->', color='red', lw=1))
        
        ax2.set_title(f'{col} - After IQR Capping')
        ax2.set_xlabel('Date')
        ax2.set_ylabel('Value')
        ax2.legend()
        ax2.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.show()
    
    print("\n=== Outlier Transformation Summary ===")
    for col in columns_with_changes:
        series_orig = df_original[col].dropna()
        series_clean = df_cleaned[col].dropna()
        changed_indices = series_orig.index[series_orig != series_clean]
        
        print(f"\n{col}: {len(changed_indices)} outliers capped")
        for change_idx in changed_indices:
            orig_val = series_orig.loc[change_idx]
            clean_val = series_clean.loc[change_idx]
            change_pct = ((clean_val - orig_val) / orig_val) * 100 if orig_val != 0 else 0
            print(f"  {str(change_idx)[:10]}: {orig_val:.4f} → {clean_val:.4f} ({change_pct:+.2f}%)")

