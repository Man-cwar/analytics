  grep_NE <- function(x,j){
    tc <- if(grepl("NE",x)) {
      paste0(j,substr(x, str_length(x)-1, str_length(x)))
    }
    return(tc)
  }
  grep_TH <- function(x,j){
    tc <- if(grepl("TH",x)) {
      paste0(j,substr(x, str_length(x)-1, str_length(x)))
    }
    return(tc)
  }
  grep_LC <- function(x,j){
    tc <- if(grepl("LC",x)) {
      paste0(j,substr(x, str_length(x)-1, str_length(x)))
    }
    return(tc)
  }
  grep_MN <- function(x,j){
    tc <- if(grepl("MN",x)) {
      paste0(j,substr(x, str_length(x)-1, str_length(x)))
    }
    return(tc)
  }
  
  
  grep_AN <- function(x,j){
    tc <- if(grepl("AN",x)) {
      paste0(j,substr(x, str_length(x)-1, str_length(x)))
    }
    return(tc)
  }
  
  grep_MD <- function(x,j){
    tc <- if(grepl("MD",x)) {
      paste0(j,substr(x, str_length(x)-1, str_length(x)))
    }
    return(tc)
  }
  
  Co <- function(x,Action,Volume) cor(stats::filter(Action,filter=x,method="recursive"),Volume)
  
  PA_Create <- function(SegVol,SegSTM,StartYear,CurrYear,EndYear,pqr){
    PA_Years <- StartYear:EndYear
    BrandShare <- data.frame(matrix(0,
                                    nrow=ncol(SegVol)-3,
                                    ncol=length(unique(SegVol$Brand))))
    rownames(BrandShare) <- gsub("X","",names(SegVol)[4:ncol(SegVol)])
    colnames(BrandShare) <- sort(unique(SegVol$Brand))
    for(i in 1:nrow(BrandShare)){
      BrandShare[i,] <- as.numeric(aggregate(SegVol[,i+3]~SegVol$Brand,
                                             data=SegVol,FUN="sum")[,2])
    }
    SBIF <- colSums(BrandShare)/sum(BrandShare) # Simple BIF
    
    lbs <- length(rownames(BrandShare))
    #SBIF <- colSums(BrandShare[(lbs-17):lbs,])/sum(BrandShare[(lbs-17):lbs,]) # Simple BIF
    
    Vol <- log(rowSums(BrandShare))
    
    PAS <- data.frame(matrix(0,nrow=(EndYear-StartYear+1)*12,ncol=6))
    rownames(PAS) <- paste0(rep(StartYear:EndYear,each=12),c(paste0(0,1:9),10:12))
    colnames(PAS) <- c("NE","TH","MN", "AN", "MD","LC")
    
    for(j in PA_Years){
      Action_in_Year <- as.vector(SegSTM[[grep(j,names(SegSTM))]])
      for(i in 1:length(Action_in_Year)){
        if(!is.na(Action_in_Year[i])){
          
          
          if(!is.null(grep_NE(Action_in_Year[i],j)) & 
             (SegSTM$`Brand`[i] %in% names(SBIF))){
            ne <- grep_NE(Action_in_Year[i],j)
            if (as.numeric(ne) <= as.numeric(CurrYear)){
              PAS$NE[which(ne==rownames(PAS))] <- PAS$NE[which(ne==rownames(PAS))] +
                (colSums(BrandShare[1:match(grep_NE(Action_in_Year[i],j),rownames(BrandShare))-1,])/
                   sum(BrandShare[1:match(grep_NE(Action_in_Year[i],j),rownames(BrandShare))-1,]))[which(SegSTM$`Brand`[i] == names(SBIF))]
            }
            else{
              PAS$NE[which(ne==rownames(PAS))] <- PAS$NE[which(ne==rownames(PAS))] +
                SBIF[which(SegSTM$`Brand`[i] == names(SBIF))]
              
            }
          }
          
          
          if(!is.null(grep_TH(Action_in_Year[i],j)) & 
             (SegSTM$`Brand`[i] %in% names(SBIF))){
            th <- grep_TH(Action_in_Year[i],j)
            if (as.numeric(th) <= as.numeric(CurrYear)){
              PAS$TH[which(th==rownames(PAS))] <- PAS$TH[which(th==rownames(PAS))] +
                (colSums(BrandShare[1:match(grep_TH(Action_in_Year[i],j),rownames(BrandShare))-1,])/
                   sum(BrandShare[1:match(grep_TH(Action_in_Year[i],j),rownames(BrandShare))-1,]))[which(SegSTM$`Brand`[i] == names(SBIF))]
            }
            else{
              PAS$TH[which(th==rownames(PAS))] <- PAS$TH[which(th==rownames(PAS))] +
                SBIF[which(SegSTM$`Brand`[i] == names(SBIF))]
              
            }
            
          }
          
          
          if(!is.null(grep_MN(Action_in_Year[i],j)) & 
             (SegSTM$`Brand`[i] %in% names(SBIF))){
            mn <- grep_MN(Action_in_Year[i],j)
            if (as.numeric(mn) <= as.numeric(CurrYear)){
              PAS$MN[which(mn==rownames(PAS))] <- PAS$MN[which(mn==rownames(PAS))] +
                (colSums(BrandShare[1:match(grep_MN(Action_in_Year[i],j),rownames(BrandShare))-1,])/
                   sum(BrandShare[1:match(grep_MN(Action_in_Year[i],j),rownames(BrandShare))-1,]))[which(SegSTM$`Brand`[i] == names(SBIF))]
            }
            else{
              PAS$MN[which(mn==rownames(PAS))] <- PAS$MN[which(mn==rownames(PAS))] +
                SBIF[which(SegSTM$`Brand`[i] == names(SBIF))]
              
            }
          }
          
          
          if(!is.null(grep_AN(Action_in_Year[i],j)) & 
             (SegSTM$`Brand`[i] %in% names(SBIF))){
            an <- grep_AN(Action_in_Year[i],j)
            if (as.numeric(an) <= as.numeric(CurrYear)){
              PAS$AN[which(an==rownames(PAS))] <- PAS$AN[which(an==rownames(PAS))] +
                (colSums(BrandShare[1:match(grep_AN(Action_in_Year[i],j),rownames(BrandShare))-1,])/
                   sum(BrandShare[1:match(grep_AN(Action_in_Year[i],j),rownames(BrandShare))-1,]))[which(SegSTM$`Brand`[i] == names(SBIF))]
            }
            else{
              PAS$AN[which(an==rownames(PAS))] <- PAS$AN[which(an==rownames(PAS))] +
                SBIF[which(SegSTM$`Brand`[i] == names(SBIF))]
              
            }
          }
          
          if(!is.null(grep_LC(Action_in_Year[i],j)) & 
             (SegSTM$`Brand`[i] %in% names(SBIF))){
            lc <- grep_LC(Action_in_Year[i],j)
            if (as.numeric(lc) <= as.numeric(CurrYear)){
              PAS$LC[which(lc==rownames(PAS))] <- PAS$LC[which(lc==rownames(PAS))] +
                (colSums(BrandShare[1:match(grep_LC(Action_in_Year[i],j),rownames(BrandShare))-1,])/
                   sum(BrandShare[1:match(grep_LC(Action_in_Year[i],j),rownames(BrandShare))-1,]))[which(SegSTM$`Brand`[i] == names(SBIF))]
            }
            else{
              PAS$LC[which(lc==rownames(PAS))] <- PAS$LC[which(lc==rownames(PAS))] +
                SBIF[which(SegSTM$`Brand`[i] == names(SBIF))]
              
            }
          }
          
          if(!is.null(grep_MD(Action_in_Year[i],j)) & 
             (SegSTM$`Brand`[i] %in% names(SBIF))){
            md <- grep_MD(Action_in_Year[i],j)
            if (as.numeric(md) <= as.numeric(CurrYear)){
              
              PAS$MD[which(md==rownames(PAS))] <- PAS$MD[which(md==rownames(PAS))] +
                (colSums(BrandShare[1:match(grep_MD(Action_in_Year[i],j),rownames(BrandShare))-1,])/
                   sum(BrandShare[1:match(grep_MD(Action_in_Year[i],j),rownames(BrandShare))-1,]))[which(SegSTM$`Brand`[i] == names(SBIF))]
            }
            else{
              PAS$MD <- PAS$MD[which(md==rownames(PAS))] +
                SBIF[which(SegSTM$`Brand`[i] == names(SBIF))]
              
            }
            
          }
          
          
        }
      }
    }
    
    # for (h in 1:ncol(PAS)){
    #  
    # lambda <- optimise(Co,Action=PAS[1:which(CurrYear == rownames(PAS)),h],
    #                       Volume=log(colSums(sales[4:ncol(sales)])),interval=c(0,1),maximum=TRUE)
    #   PAS[h] <- as.vector(stats::filter(PAS[h], filter = lambda$maximum, method = "recursive"))}
    
    
    for(i in 2:nrow(PAS)){
      PAS[i,]<- PAS[i,] +0.99*PAS[(i-1),]
    }
    PAS$AN <- 0.75*PAS$AN
    PAS$MD <- 0.5*PAS$MD
    PAS$TH <- 0.5*PAS$TH
    PAS$MN <- 0.25*PAS$MN
    PAS$PA <- PAS$NE+PAS$AN+PAS$MD+PAS$TH+PAS$MN+PAS$LC
    
    #PAS$PA <- PAS$NE+0.75*PAS$AN+0.5*(PAS$MD+PAS$TH) + 0.25*PAS$MN + PAS$LC
    names(PAS) <- paste(pqr,names(PAS),sep = "_")
    PAS$tf <- row.names(PAS)
    return(PAS)
  }
  
  
  for (np in seg_uni) {
    
    SegVol <- subset(sales, Segment == np)
    SegSTM <- subset(STM, Segment == np)
    PAS2 <- PA_Create(SegVol,SegSTM,StartYear,CurrYear,EndYear,np)
    lj <- left_join(lj,PAS2, by = c("tf" = "tf"), all.x = TRUE)
    
  }
  
  
