    return df

def calculate_confidence_intervals(params, cov, alpha=0.05):
    """
    Calculate confidence intervals for the parameters.
    """
    param_se = np.sqrt(np.diag(cov))
    ci_bounds = norm.ppf(1 - alpha / 2) * param_se
    return params - ci_bounds, params + ci_bounds

def calculate_mape(y_true, y_pred):
    return mean_absolute_percentage_error(y_true, y_pred)
def calculate_rmse(y_true, y_pred):
    return np.sqrt(mean_squared_error(y_true, y_pred))

