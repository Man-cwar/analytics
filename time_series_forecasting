def calculate_confidence_intervals_exp(forecast, residuals, alpha=0.05):
    se = np.std(residuals)
    z_score = norm.ppf(1 - alpha / 2)
    lower_bound = forecast - z_score * se
    upper_bound = forecast + z_score * se
    return lower_bound, upper_bound
class AdvancedLSTMModel(nn.Module):
    def __init__(self, input_size, hidden_layer_size, output_size, num_layers=2, dropout=0.2, bidirectional=True):
        super(AdvancedLSTMModel, self).__init__()
        self.hidden_layer_size = hidden_layer_size
        self.num_layers = num_layers
        self.bidirectional = bidirectional
        self.lstm = nn.LSTM(input_size, hidden_layer_size, num_layers=num_layers, dropout=dropout, bidirectional=bidirectional)
        self.linear = nn.Linear(hidden_layer_size * 2 if bidirectional else hidden_layer_size, output_size)

    def forward(self, input_seq):
        batch_size = input_seq.size(1)  # Get the batch size
        hidden_cell = (torch.zeros(self.num_layers * 2 if self.bidirectional else self.num_layers, batch_size, self.hidden_layer_size),
                       torch.zeros(self.num_layers * 2 if self.bidirectional else self.num_layers, batch_size, self.hidden_layer_size))
        lstm_out, _ = self.lstm(input_seq, hidden_cell)
        predictions = self.linear(lstm_out[-1])  # Use the output of the last time step
        return predictions

def prepare_lstm_data(series, exogenous, n_lags):
    X, y = [], []
    for i in range(len(series) - n_lags):
        X.append(np.hstack((series[i:i + n_lags], exogenous[i:i + n_lags])))
        y.append(series[i + n_lags])
    return np.array(X), np.array(y)

def smooth_curve(x, y, smooth_factor=300):
    x_smooth = np.linspace(x.min(), x.max(), smooth_factor)
    y_smooth = make_interp_spline(x, y)(x_smooth)
    return x_smooth, y_smooth

def varima_model(endog, order=(1, 0, 0)):
    model = VARMAX(endog=endog, order=order).fit(disp=False)
    return model

def calculate_confidence_intervals_varm(forecast, residuals, alpha=0.05):
    se = np.std(residuals)
    z_score = norm.ppf(1 - alpha / 2)
    lower_bound = forecast - z_score * se
    upper_bound = forecast + z_score * se
    return lower_bound, upper_bound

def perform_granger_causality_tests(data, target_variable, max_lag=12):
    variables = data.columns
    test_results = {}
    for var in variables:
        if var != target_variable:
            test_result = grangercausalitytests(data[[target_variable, var]], max_lag, verbose=False)
            test_results[var] = min([test_result[lag][0]['ssr_chi2test'][1] for lag in range(1, max_lag + 1)])
    return test_results

