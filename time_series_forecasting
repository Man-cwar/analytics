def calculate_mutual_information(new_df, target_variable):
    return mutual_info_regression(new_df.drop(columns=[target_variable]), new_df[target_variable])

def time_series_modeling(y, exog_vars, with_intercept=True, seasonal=True, m=1):
    model_fit = pm.auto_arima(y, X=exog_vars, with_intercept=with_intercept, seasonal=seasonal, m=m, trace=True, error_action="ignore", suppress_warnings=True).fit(y, X=exog_vars)
    return model_fit

def time_series_modeling_sarimax(y, exog_vars, ar_para, d, ma_para, m, ar_para_s, D, ma_para_s):
    if m is None:  # No seasonality when m is None
        model_fit = SARIMAX(y, exog=exog_vars, order=(ar_para, d, ma_para)).fit()
    else:
        model_fit = SARIMAX(y, exog=exog_vars, order=(ar_para, d, ma_para), seasonal_order=(ar_para_s, D, ma_para_s, m)).fit()
    return model_fit

def bass_model_with_exog(t, p, q, m, *betas, exogs):
    adoption = (m * (1 - np.exp(-(p + q) * t)) / (1 + (q / p) * np.exp(-(p + q) * t)))
    exog_effect = sum(beta * exog for beta, exog in zip(betas, exogs))
    return adoption + exog_effect
def bass_model_univariate(t, p, q, m):
    adoption = (m * (1 - np.exp(-(p + q) * t)) / (1 + (q / p) * np.exp(-(p + q) * t)))
    return adoption

def logistic_growth(t, L, k, x0):
    return L / (1 + np.exp(-k * (t - x0)))

def logistic_growth_with_exog(t, L, k, x0, *betas, exogs):
    base_growth = L / (1 + np.exp(-k * (t - x0)))
    exog_effect = sum(beta * exog for beta, exog in zip(betas, exogs))
    return base_growth + exog_effect


def exponential_smoothing_model(y, seasonal_periods, trend, seasonal):
    model = ExponentialSmoothing(y, trend=trend, seasonal=seasonal, seasonal_periods=seasonal_periods).fit()
    return model


def apply_fourier_transform(df, exog_vars, period):
    for var in exog_vars:
        fft_values = fft(df[var].values)
        df[f'{var}_fft'] = np.abs(fft_values)
    return df

